# Configuração da função ler-emails. Estes valores vão como SECRETS no Supabase
# (supabase secrets set ...), nunca em arquivo versionado. Este arquivo só documenta os nomes.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem automaticamente dentro da Edge Function.

# --- Conexão IMAP (troca Gmail <-> Locaweb mudando só estes valores) ---
# Gmail (teste):    imap.gmail.com / 993 / true  (senha de app, não a senha da conta)
# Locaweb (final):  host/porta/SSL conforme o painel da Locaweb
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=conta.de.teste@gmail.com
IMAP_PASS=
IMAP_MAILBOX=INBOX

# --- Segurança ---
# Obrigatório. Quem chama a função envia este valor no cabeçalho x-ler-emails-segredo. Sem ele: 401.
LER_EMAILS_SEGREDO=
# Esta função roda no projeto de produção (único projeto). A trava interna exige este valor explícito.
AMBIENTE=producao

# --- Regras ---
# Rótulo da caixa gravado em pre_cadastros.caixa (ex.: gmail-teste, ivan)
CAIXA_NOME=gmail-teste
# Remetentes autorizados, separados por vírgula. "@dominio.com" libera o domínio inteiro.
# Vazio = nenhum e-mail é processado.
REMETENTES_AUTORIZADOS=
# Quantos dias para trás olhar a cada execução (a duplicidade é evitada pelo Message-ID no banco)
JANELA_DIAS=3
# Teto de mensagens lidas por execução
MAX_POR_EXECUCAO=200
